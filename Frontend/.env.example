# Copia este archivo como .env y ajusta el valor.

# URL de la API (backend), terminada en /api.
# - En desarrollo puedes dejarla vacía: se usa http://localhost:3000/api
# - Para compilar la versión que se publica en Firebase es obligatoria, por ejemplo:
#   VITE_API_URL=https://nailsoft-api.onrender.com/api
VITE_API_URL=
