# Copia este archivo como .env y llena los valores. Nunca subas el .env al repositorio.
# En Render, estas mismas variables se configuran en Environment.

PORT=3000

# Cadena de conexión de MongoDB Atlas (mongodb+srv://usuario:clave@cluster.xxxxx.mongodb.net/nailsoft?retryWrites=true&w=majority)
MONGODB_CNN=

# Secreto para firmar los tokens JWT (obligatorio: el servidor no arranca sin él).
# Usa al menos 32 caracteres aleatorios. Para generar uno:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Dominios del frontend que pueden llamar la API, separados por comas.
# En producción pon aquí tu dominio de Firebase, por ejemplo:
#   CORS_ORIGINS=https://mi-proyecto.web.app,https://mi-proyecto.firebaseapp.com
# Si se deja vacío solo se permite el desarrollo local (localhost:5173 y localhost:3000).
CORS_ORIGINS=

# Correo para enviar los códigos de recuperación de contraseña.
# Opción A, Gmail: usa una "contraseña de aplicación" (no la contraseña normal).
# Opción B, Brevo u otro SMTP: llena EMAIL_HOST y EMAIL_PORT; EMAIL_USER y
# EMAIL_PASSWORD son el usuario y la clave SMTP, y EMAIL_FROM el remitente verificado.
EMAIL_SERVICE=gmail
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Imágenes de servicios y productos (obligatorio en Render, que borra su disco en cada
# despliegue). Cópiala de Cloudinary: Dashboard → "API environment variable".
# Si se deja vacía, las imágenes se guardan en la carpeta uploads/ (solo para desarrollo).
CLOUDINARY_URL=

# Administrador inicial: lo crea "npm run db:init" en una base vacía.
# La contraseña debe tener 8-64 caracteres, mayúscula, minúscula, número y carácter especial.
# Después de crearlo puedes borrar ADMIN_PASSWORD de este archivo.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=
ADMIN_APELLIDO=
ADMIN_CELULAR=
