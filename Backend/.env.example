# Copia este archivo como .env y llena los valores. Nunca subas el .env al repositorio.

PORT=3000

# Orígenes del frontend que pueden llamar la API desde el navegador, separados por comas.
# Si se deja vacío se usan los de Firebase (nailsoft-7d03c) y localhost:5173 / localhost:3000.
CORS_ORIGINS=

# Cadena de conexión de MongoDB Atlas (mongodb+srv://usuario:clave@cluster/NailsSoft?...)
MONGODB_CNN=

# Correo para recuperar contraseñas (con Gmail, usa una contraseña de aplicación)
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=

# Secreto para firmar los tokens JWT (obligatorio: el servidor no arranca sin él).
# Usa al menos 32 caracteres aleatorios. Para generar uno:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
